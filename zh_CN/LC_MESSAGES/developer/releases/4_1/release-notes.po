msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:82
#: 9e203d6a3dd74a62b4e8d522f0a32bcb
msgid "The term “VM” has largely been replaced by “qube”"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:84
#: 1fdf22ea86e14d58811ddd0b73fa1829
msgid ""
"GUI daemon is now configured using ``qvm-features`` tool, ``/etc/qubes/guid."
"conf`` file is no longer used"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:86
#: 89ff6140efe4408fa17f1dfe81665f94
msgid ""
"``qvm-run`` tool got ``--no-shell`` option to run a single command without "
"using a shell inside the qube"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:88
#: ba256c02d9ce477b81f9091b5ba3ff54
