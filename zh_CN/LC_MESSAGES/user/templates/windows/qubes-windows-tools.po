#: 9b1ef59df19448a49715267c9d2630bd
msgid "|windows-seamless-4.png| |windows-seamless-1.png|"
msgstr ""

#: ../../../user/templates/windows/qubes-windows-tools.rst:693
#: f57d41faf7044a929dd9c7bb4c47d4a5
msgid "windows-seamless-4.png"
msgstr ""

#: ../../../user/templates/windows/qubes-windows-tools.rst:696
#: 4c28a66005ff45499213cd1814f0714b
