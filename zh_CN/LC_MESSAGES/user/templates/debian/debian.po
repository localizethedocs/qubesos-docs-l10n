msgstr ""

#: ../../../user/templates/debian/debian.rst:101
#: 1ae76d596cd640acaa2ea72d237b4711
msgid "``systemctl disable ssh``"
msgstr ""

#: ../../../user/templates/debian/debian.rst:103
#: 059a5f52346047afacec5fdbf694fe07
msgid "``systemctl mask ssh``"
msgstr ""

#: ../../../user/templates/debian/debian.rst:105
#: 3e5604da06fa44b0be94bdfedd3f03cb
msgid "Close down template"
msgstr ""

#: ../../../user/templates/debian/debian.rst:109
#: 60bcd642962746869adb472f61f01834
msgid "Now the ssh service will **NOT** start in qubes based on this template."
msgstr ""

#: ../../../user/templates/debian/debian.rst:111
