#: ../../../user/templates/debian/debian.rst:3 004e3c6af0164f4f8f3667c1d5773665
msgid "Debian templates"
msgstr ""

#: ../../../user/templates/debian/debian.rst:6 3270d4e244024837963eac1b88bf8cef
msgid ""
"The Debian :term:`template` is an officially :ref:`supported <user/"
"downloading-installing-upgrading/supported-releases:templates>` template in "
"Qubes OS. The Current version is Debian |debian-version| (“|debian-"
"codename|”). It is available in 3 versions - ``debian-13-xfce``, the default "
"Debian template with the Xfce desktop environment; ``debian-13``, an "
"alternative Debian template with the GNOME desktop environment; and "
"``debian-13-minimal``. This page is about the “full” templates. For the "
"minimal version, please see the :doc:`Minimal templates </user/templates/"
"minimal-templates>` page."
msgstr ""

