msgstr ""

#: ../../../introduction/faq.rst:423 ec0b3e63c3024c3ea7dc7457bf26f456
msgid "Is there any certified hardware for Qubes OS?"
msgstr ""

#: ../../../introduction/faq.rst:426 776b2e06ab164b0bbafc9873d5de53f2
