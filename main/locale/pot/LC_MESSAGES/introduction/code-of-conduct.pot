#: 922857b94eb64071aadd1f3ae133712c
msgid ""
"Examples of behavior that contributes to creating a positive environment "
"include:"
msgstr ""

#: ../../../introduction/code-of-conduct.rst:24
#: 41885949a0244648ba53c82cbd115420
msgid "Using welcoming and inclusive language"
msgstr ""

#: ../../../introduction/code-of-conduct.rst:26
#: f64e95863f8643c3b5b741e88ec1bd6a
msgid "Being respectful of differing viewpoints and experiences"
msgstr ""

#: ../../../introduction/code-of-conduct.rst:28
#: 03c22170345d48e8ba5a1d82378b01cd
msgid "Gracefully accepting constructive criticism"
msgstr ""

#: ../../../introduction/code-of-conduct.rst:30
#: c06165d0e74e409db3b61aa894ac10c3
msgid "Focusing on what is best for the community"
msgstr ""

#: ../../../introduction/code-of-conduct.rst:32
#: 6c09e48950d14588ba49f604b84f4b70
msgid "Showing empathy towards other community members"
msgstr ""

#: ../../../introduction/code-of-conduct.rst:36
#: 2dd255c450614a35a7777c1c273c647a
msgid "Examples of unacceptable behavior by participants include:"
msgstr ""

#: ../../../introduction/code-of-conduct.rst:38
#: b25bac1432b8403590f7582342287584
msgid ""
"The use of sexualized language or imagery and unwelcome sexual attention or "
