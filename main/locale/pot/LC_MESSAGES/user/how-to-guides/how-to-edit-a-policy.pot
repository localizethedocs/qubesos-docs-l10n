"Click on :guilabel:`Accept` and at the bottom of the window, select either :"
"guilabel:`OK` or :guilabel:`Apply`."
msgstr ""

#: ../../../user/how-to-guides/how-to-edit-a-policy.rst:34
#: 8d8c5f251dd5461a87b3a30fd907162d
msgid "Edit a policy with :program:`Qubes Policy Editor`"
msgstr ""

#: ../../../user/how-to-guides/how-to-edit-a-policy.rst:36
#: 8bc5717485db4d2aacf99e38df7bbc59
msgid "Open :program:`Qubes Policy Editor`:"
