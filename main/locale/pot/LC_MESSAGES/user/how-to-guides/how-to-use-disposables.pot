msgid ""
"It is also possible to do the same from the command line using :program:`qvm-"
"open-in-dvm`:"
msgstr ""

#: ../../../user/how-to-guides/how-to-use-disposables.rst:125
#: 286875c8d25e4d0b83d9b1e44a855286
msgid ""
