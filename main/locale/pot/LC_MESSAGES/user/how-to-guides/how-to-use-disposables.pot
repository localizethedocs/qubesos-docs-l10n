msgid ""
"Qube settings of ``default-mgmt-dvm`` with preloaded disposable setting "
"configured to ``2``."
msgstr ""

#: ../../../user/how-to-guides/how-to-use-disposables.rst:213
#: 0d4359b8a5f540cf88c3c352954238a4
msgid ""
"This can also be changed from the command line from the :term:`GUI domain`, "
