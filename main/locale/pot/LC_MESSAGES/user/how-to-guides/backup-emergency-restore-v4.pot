#: 5c2fe45666b94bbcb3d53fd88a575814
msgid "Emergency recovery instructions"
msgstr ""

#: ../../../user/how-to-guides/backup-emergency-restore-v4.rst:76
#: d53cecd01b604280af14874aa3709709
msgid ""
"**Note:** In the following example, the backup file is both *encrypted* and "
"*compressed*."
msgstr ""

#: ../../../user/how-to-guides/backup-emergency-restore-v4.rst:78
#: 977b81748250466ea082490a60976d7c
msgid "Untar the backup metadata from the main backup file."
msgstr ""

#: ../../../user/how-to-guides/backup-emergency-restore-v4.rst:90
#: bb638b1fa716409d9f6bfd3ba65516cf
msgid ""
"Set the backup passphrase environment variable. While this isn’t strictly "
"required, it will be handy later and will avoid saving the passphrase in the "
"shell’s history."
msgstr ""

#: ../../../user/how-to-guides/backup-emergency-restore-v4.rst:97
#: 2e3befc3376b4cbfbbfc232bc66acf8f
msgid ""
"Type in your passphrase (it will be visible on screen!) and press Enter."
msgstr ""

