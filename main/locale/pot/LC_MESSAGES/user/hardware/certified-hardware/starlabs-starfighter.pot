#: ../../../user/hardware/certified-hardware/starlabs-starfighter.rst:24
#: 1e34917fbad647a4a0c2114266eb846f
msgid ""
"Certified: Standard (Intel Core Ultra 5 125H + 32GB LPDDR5X + QHD display)"
msgstr ""

#: ../../../user/hardware/certified-hardware/starlabs-starfighter.rst:26
#: 79304a5f6612422392b8605dc22f4db2
msgid ""
"Certified: Ultra (Intel Core Ultra 9 285H + 64GB LPDDR5X + 4K display, "
"disclaimer below)"
msgstr ""

#: ../../../user/hardware/certified-hardware/starlabs-starfighter.rst:28
#: b9927cc459934494b26c24abdefa802a
msgid "The AMD configuration is not certified."
msgstr ""

#: ../../../user/hardware/certified-hardware/starlabs-starfighter.rst:30
#: 26f5f313e2e3400ca1c0bd422ff65d2e
msgid ""
"**Warning:** While both the QHD and 4K display variants will work, the 4K "
"display will run at a lower resolution (Full HD) due to the absence of "
"proper support for HiDPI in Qubes OS. While users can manually change the "
"resolution to 4K, we cannot guarantee everything will work properly. For "
"example, there are known issues with both UI scaling and full-screen video "
"playback performance in 4K. This limitation may be lifted in a future Qubes "
"OS release."
msgstr ""

