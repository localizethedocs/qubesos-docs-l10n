msgstr ""

#: ../../../user/security-in-qubes/mfa.rst:151 26a72889a5e549058551525d04f4dd74
msgid "install software for the YubiKey / NitroKey3,"
msgstr ""

#: ../../../user/security-in-qubes/mfa.rst:153 3d3be3c096a241a78d742bf07f7e9c7b
msgid ""
"configure the YubiKey for the `Challenge-Response <https://en.wikipedia.org/"
"wiki/Challenge%E2%80%93response_authentication>`__ mode or the NitroKey3 for "
"`HOTP <https://en.wikipedia.org/wiki/HMAC-based_one-time_password>`__ mode,"
msgstr ""

#: ../../../user/security-in-qubes/mfa.rst:155 8681e605bb0e4090b29373a259feaa26
msgid ""
"store the password for YubiKey / NitroKey3 Login and the Challenge-"
"Response / HOTP secret in dom0,"
msgstr ""

#: ../../../user/security-in-qubes/mfa.rst:157 679a20654c8545da9b447c88227fd87d
msgid ""
"enable YubiKey / NitroKey3 authentication for every service you want to use "
"it for."
msgstr ""

