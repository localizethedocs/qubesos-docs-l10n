msgid ""
"Passwordless root is provided by the ``qubes-core-agent-passwordless-root`` "
"package."
msgstr ""

#: ../../../user/security-in-qubes/vm-sudo.rst:62
#: 66b57a460d0f4c4383c7f63874579f43
msgid ""
"Details of the implementation are :doc:`here </developer/system/vm-sudo>`."
msgstr ""

#: ../../../user/security-in-qubes/vm-sudo.rst:64
#: 0a49617c1416444facd6233b47ae4b59
msgid ""
":doc:`Minimal templates </user/templates/minimal-templates>`, which are "
"intended for use by advanced users, do not have this package installed by "
"default."
msgstr ""

#: ../../../user/security-in-qubes/vm-sudo.rst:67
