msgstr ""

#: ../../../user/troubleshooting/update-troubleshooting.rst:20
#: 53cfc4273d644cf08e2937b8474cb6e3
msgid ""
"https://stackoverflow.com/questions/45318256/error-failed-to-synchronize-"
"cache-for-repo-updates"
msgstr ""

#: ../../../user/troubleshooting/update-troubleshooting.rst:24
