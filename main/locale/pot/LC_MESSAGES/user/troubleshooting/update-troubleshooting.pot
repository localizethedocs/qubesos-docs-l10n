msgid ""
"\"Failed to synchronize cache for repo\" errors when updating Fedora "
"templates"
msgstr ""

#: ../../../user/troubleshooting/update-troubleshooting.rst:10
#: 39627ee0634b4117931c730812f2925b
msgid ""
"This is a general Fedora issue, not one that is Qubes-specific. Usually, the "
"issue is due to network problems (especially if downloading updates over "
"Tor) or problems with the download mirrors. Often, the problem can be "
"resolved by trying again on a different connection (a different Tor circuit, "
"if using Tor) or waiting and trying again later. Sometimes you may need to "
"clear the dnf cache. Here are some examples of non-Qubes reports about this "
"problem:"
msgstr ""

#: ../../../user/troubleshooting/update-troubleshooting.rst:12
#: f58025ba9a8d4a29a5455c67e6d3162b
msgid ""
"https://discussion.fedoraproject.org/t/issues-with-dnf-upgrade-on-fedora-30-"
"failed-to-synchronize-cache-for-repo/71681"
msgstr ""

#: ../../../user/troubleshooting/update-troubleshooting.rst:14
#: ce6ea65493b94177bfc2831fdd548294
msgid ""
"https://unix.stackexchange.com/questions/390805/repos-not-working-on-fedora-"
"error-failed-to-synchronize-cache-for-repo-update"
msgstr ""

#: ../../../user/troubleshooting/update-troubleshooting.rst:16
#: 6fd92f6da5eb4da89e8aa26c90c85990
msgid ""
"https://www.reddit.com/r/Fedora/comments/74nldq/"
"fedora_26_dnf_error_failed_to_synchronize_cache/"
msgstr ""

