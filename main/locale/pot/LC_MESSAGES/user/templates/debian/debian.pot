#: ../../../user/templates/debian/debian.rst:70
#: 662093f8f1234cf7b318f088abcde40f
msgid "Starting services"
msgstr ""

#: ../../../user/templates/debian/debian.rst:73
#: a5a0ca03c4244603ab4acc4d565a2fb3
msgid ""
"The Debian way (generally) is to start daemons if they are installed. This "
"means that if you install (say) ssh-server in a template, *all* the qubes "
"that use that template will run a ssh server when they start. (They will, "
"naturally, all have the same server key.) This may not be what you want."
msgstr ""

#: ../../../user/templates/debian/debian.rst:75
#: e33a2981473645aab2bc4d3336885551
msgid ""
"So be very careful when installing software in Templates - if the daemon "
"spawns outbound connections then there is a serious security risk."
msgstr ""

#: ../../../user/templates/debian/debian.rst:77
#: 5b2c9a2eea974bcabb221414fe289c65
msgid "In general, a reasonable approach would be, (using ssh as example):"
msgstr ""

#: ../../../user/templates/debian/debian.rst:79
#: c44965600dd0407a9160fce15fffeddd
msgid "Install the ssh service."
msgstr ""

#: ../../../user/templates/debian/debian.rst:81
#: dfc6ab81f289422bb26e6b07be4a2bef
msgid "``systemctl stop ssh``"
msgstr ""

#: ../../../user/templates/debian/debian.rst:83
#: a44fce4163804a88b9fabd818d8c81e3
msgid "``systemctl disable ssh``"
msgstr ""

#: ../../../user/templates/debian/debian.rst:85
#: 8e87b54d395a4ea19671dd70821a0a6d
msgid "``systemctl mask ssh``"
msgstr ""

#: ../../../user/templates/debian/debian.rst:87
#: 450965cf8ace4ababd9332a6a3da30a0
msgid "Close down template"
msgstr ""

#: ../../../user/templates/debian/debian.rst:91
#: a76dc96261004871a78c2f7b4870ea2d
