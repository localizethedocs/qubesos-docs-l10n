msgstr ""

#: ../../../user/templates/debian/debian.rst:81
#: 6ee18a1a9f444a9ab1a7be0d9d5a3c71
msgid "``systemctl stop ssh``"
msgstr ""

#: ../../../user/templates/debian/debian.rst:83
#: cedeb7d764b3420fbb774bb7c6b06817
msgid "``systemctl disable ssh``"
msgstr ""

#: ../../../user/templates/debian/debian.rst:85
#: a7102a23ca794b7f903cc5a5e416e801
msgid "``systemctl mask ssh``"
msgstr ""

#: ../../../user/templates/debian/debian.rst:87
#: 7333e3973f96430e827e0a3bf50a38cf
msgid "Close down template"
msgstr ""

#: ../../../user/templates/debian/debian.rst:91
#: ff9b07d71b0243239c63880c041b986d
