"<https://yum.qubes-os.org/r4.2/current/dom0/fc37/rpm/qubes-windows-"
"tools-4.1.69-1.fc37.noarch.rpm>`__ )."
msgstr ""

#: ../../../user/templates/windows/qubes-windows-tools.rst:224
#: 262014d95d6d496a9964ae0e30ff66f0
msgid ""
