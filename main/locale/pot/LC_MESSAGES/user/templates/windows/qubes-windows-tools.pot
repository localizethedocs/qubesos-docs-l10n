#: 9bd7043f987243b387623153309263cc
msgid ""
"Start the command prompt as Administrator, i.e., right-click on the Command "
"Prompt icon (All Programs -> Accessories) and choose \"Run as "
"administrator\"."
msgstr ""

#: ../../../user/templates/windows/qubes-windows-tools.rst:144
#: aa1cb32f632c4cb18f2e7ee8d7ac019d
msgid "In the command prompt, type ``bcdedit /set testsigning on``"
msgstr ""

#: ../../../user/templates/windows/qubes-windows-tools.rst:146
