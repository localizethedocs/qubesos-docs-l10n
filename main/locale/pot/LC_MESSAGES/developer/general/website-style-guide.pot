msgid "|alerts|"
msgstr ""

#: ../../../developer/general/website-style-guide.rst:264
#: 27f6a4e56cec4d39867fd3ec240e2c51
msgid ""
"Depicts different alerts and messages: note, warning, danger and how they "
"are rendered on the website"
msgstr ""

