#: ../../../developer/releases/4_1/release-notes.rst:3
#: 2296848db379413f90c88d2e658b7eeb
msgid "Qubes OS 4.1 release notes"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:7
#: f192fe1239c1498d8742e80ed94b5504
msgid "New features and improvements since Qubes 4.0"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:10
#: 02353381230c49939a37f0c42a8493b4
msgid ""
"Optional qubes-remote-support package now available from repositories "
"(strictly opt-in, no package installed by default; no new ports or network "
"connections open by default; requires explicit connection initiation by the "
"user, then requires sharing a code word with the remote party before a "
"connection can be established; see `#6364 <https://github.com/QubesOS/qubes-"
"issues/issues/6364>`__ for more information)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:12
#: 52c1dc426a0346feaefa3028885906c9
msgid ""
"Qubes firewall reworked to be more defensive (see `#5540 <https://github.com/"
"QubesOS/qubes-issues/issues/5540>`__ for details)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:14
#: d47e30c9ace840c7a3601dcb3075dfef
msgid "Xen upgraded to version 4.14"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:16
#: 27791f4980e549af93b7e8b5119cb45a
msgid "Dom0 operating system upgraded to Fedora 32"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:18
#: e2844de3d8494aaea79b05b40ab03793
msgid "Default desktop environment upgraded to Xfce 4.14"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:20
#: a92dcbd1fe084232bfac06e076e20047
msgid "Upgraded default template releases"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:22
#: a224bbf7f53343e8b7c294bc510a59a1
msgid ""
"Experimental support for GUI running outside of dom0 (hybrid mode GUI domain "
"without real GPU passthrough; see `#5662 <https://github.com/QubesOS/qubes-"
"issues/issues/5662>`__ for details)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:24
#: 45a58d7809974a3bb78193a13d5049f9
msgid ""
"Experimental support for audio server running outside of dom0 (“Audio "
"domain”)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:26
#: bd5a679166224caa9e0e364cecdd827c
msgid "sys-firewall and sys-usb are now disposables by default"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:28
#: 17cbceff2e64454cb31e2776dac655fd
msgid ""
"UEFI boot now loads GRUB, which in turn loads Xen, making the boot path "
"similar to legacy boot and allowing the user to modify boot parameters or "
"choose an alternate boot menu entry"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:30
#: a3b90cee06954188b1110e25376a8f1d
msgid ""
"New qrexec policy format (see `#4370 <https://github.com/QubesOS/qubes-"
"issues/issues/4370>`__ for details)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:32
#: a9d13677ab9c4ea5863e356c60a90b78
msgid ""
"qrexec protocol improvements (see `#4909 <https://github.com/QubesOS/qubes-"
"issues/issues/4909>`__ for details)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:34
#: d0cecd1035be4e79a24f5ae266c93cce
msgid "New qrexec-policy daemon"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:36
#: 74fbbb03f6e249f89a3e3191a6ccd33a
msgid "Simplified using in-qube kernels"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:38
#: 0a25149626124256a2fe201f68f3eb31
msgid ""
"Windows USB and audio support courtesy of `tabit-pro <https://github.com/"
"tabit-pro>`__ (see `#5802 <https://github.com/QubesOS/qubes-issues/"
"issues/5802>`__ and `#2624 <https://github.com/QubesOS/qubes-issues/"
"issues/2624>`__)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:40
#: b98e4c1c431844b18d3c53fe6019f8e1
msgid "Clarified disposable-related terminology and properties"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:42
#: 88b09d4e726a411dbd4568e3ba1629ff
msgid "Default kernelopts can now be specified by a kernel package"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:44
#: cf5014d09c8d4cf4a66f195a5610f64c
msgid "Improved support for high-resolution displays"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:46
#: 42e22386114b4e5682068d6f2cd9342e
msgid "Improved notifications when a system drive runs out of free space"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:48
#: bbca252eb55144aaa92c64ff368b929a
msgid "Support for different cursor shapes"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:50
#: d1f6241ac6a34a06a5c5e77b99c01154
msgid ""
"“Paranoid mode” backup restore option now properly supported using "
"disposables"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:52
#: 5ed21fb18df7470e86cad0a096e6c286
msgid "Users can now choose between Debian and Fedora in the installer"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:54
#: 2edc5bd1bb864e44b239425405b4a906
msgid ""
"Certain files and applications are now opened in disposables, e.g., "
"Thunderbird email attachments"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:56
#: 612a8961c50c4a39ab6a53d267213829
msgid "New graphical interface for managing testing repository updates"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:58
#: c3d8c3cdb5dc4bba84c547db22fd6d85
msgid "New “Cute Qube” icon family (replaces padlock icons)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:60
#: 0065d9f551dd4efca1d5fcbb26fa1ab5
msgid "Disposable qube types now use the disposable icon"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:62
#: 8d383836bbcb429b9ddfe8f442f916ab
msgid ""
"New Template Manager tool for installing, removing, and updating templates "
"(meanwhile, the tool previously known as the “Template Manager,” which was "
"for mass template switching, has been integrated into the Qube Manager)"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:64
#: cdeba56255194d7c9f171a9b3315f2c6
msgid ""
"The “file” storage driver has been deprecated in Qubes 4.1 and will be "
"removed in Qubes 4.2"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:66
#: 9ba6eb00f52d4311a23f1ed027aa9bbd
msgid "``property-del`` event renamed to ``property-reset`` to avoid confusion"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:68
#: b7d65d28d7ac4af1a40b5f64afa1f1c2
msgid "qrexec no longer supports non-executable files in ``/etc/qubes-rpc``"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:70
#: 21b4e7cfddd54d3487002350944ca1eb
msgid "qrexec components have been reorganized into the core-qrexec repository"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:72
