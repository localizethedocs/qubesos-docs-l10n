msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:74
#: 3a8e152f85e84136ba32ce8f1b686dfe
msgid "Removed the need for the out-of-tree u2mfn kernel module"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:76
#: 74121df04abd4640b5137ebfe97452d3
msgid "Qrexec services can now run as a socket server"
msgstr ""

#: ../../../developer/releases/4_1/release-notes.rst:78
#: e0df1fbe2aaa4dd28ed07a084b1ed21b
