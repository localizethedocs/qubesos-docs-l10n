msgstr ""

#: ../../../developer/services/qrexec2.rst:245 20a3d888a8ac45688c02c9c74e063853
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 286ac2e577f4493c99a7e1b4c6da3f1b
