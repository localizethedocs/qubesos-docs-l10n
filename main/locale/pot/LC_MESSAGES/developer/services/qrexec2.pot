msgstr ""

#: ../../../developer/services/qrexec2.rst:245 cdf1f3797e4840d99ca47f02b3a873a5
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 1da5a409fbe241ba85a084e633495471
