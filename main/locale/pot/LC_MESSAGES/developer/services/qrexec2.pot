#: ../../../developer/services/qrexec2.rst:243 68088605cea449c7ba23de93fbb33dfb
msgid ""
"The VM-VM channels in Qubes R2 are made via “gluing” two VM-Dom0 and Dom0-VM "
"vchan connections:"
msgstr ""

#: ../../../developer/services/qrexec2.rst:245 70a82ddb0a8c4754825a312a36daf02a
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 b455f6fbcefa405a9980048e5e20f85c
