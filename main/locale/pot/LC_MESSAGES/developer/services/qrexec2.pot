msgstr ""

#: ../../../developer/services/qrexec2.rst:245 c55436d18032412e8c1ab3dcb3a2f7e2
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 2beee6c434a442aea67b0a92c1dae6a9
