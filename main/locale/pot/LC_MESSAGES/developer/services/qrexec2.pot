msgstr ""

#: ../../../developer/services/qrexec2.rst:245 a72e32b21b7742d49ed3c28532500bdf
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 21e212a5d53d475389fe7614e79a5eba
