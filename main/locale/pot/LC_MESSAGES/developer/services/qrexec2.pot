msgstr ""

#: ../../../developer/services/qrexec2.rst:245 3fb15b1360224297bf6f3029cfe867de
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 04688b099145420cb924d6169995488a
