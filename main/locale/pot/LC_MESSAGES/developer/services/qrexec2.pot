msgstr ""

#: ../../../developer/services/qrexec2.rst:245 674f8202c99449cfa6535d462ecda1a4
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 75f0f3b731ba46a8be5ce14693d1c12d
