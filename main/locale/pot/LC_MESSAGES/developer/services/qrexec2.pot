msgstr ""

#: ../../../developer/services/qrexec2.rst:245 5b7c3c1ea38643af8b734f3046b7f3ab
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 ed67679ff95f4308b15c1c05cb4c1897
