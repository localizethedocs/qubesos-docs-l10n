"vchan connections:"
msgstr ""

#: ../../../developer/services/qrexec2.rst:245 57636c399cf649aca76c3246896857d7
msgid "qrexec2-internals.png"
msgstr ""

#: ../../../developer/services/qrexec2.rst:250 0c000f4cb32343e481967b97f11634c7
