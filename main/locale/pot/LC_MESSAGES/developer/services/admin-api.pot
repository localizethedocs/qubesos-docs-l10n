#: ../../../developer/services/admin-api.rst:10
#: e70c2a11e85b43e1b8483e1127b949f4
msgid ""
"The goals of the Admin API system is to provide a way for the user to manage "
"the domains without direct access to dom0."
msgstr ""

#: ../../../developer/services/admin-api.rst:13
#: c545ff14fecb45808fb9447d3d89bdb5
msgid "Foreseen benefits include:"
