#: ../../../developer/services/admin-api.rst:10
#: 68bea937d3404b1ea5737a5ba547c283
msgid ""
"The goals of the Admin API system is to provide a way for the user to manage "
"the domains without direct access to dom0."
msgstr ""

#: ../../../developer/services/admin-api.rst:13
#: 44f7444faaad4150a6493eabcdd3790e
msgid "Foreseen benefits include:"
msgstr ""

#: ../../../developer/services/admin-api.rst:15
#: 0ebab9fd33bd43e8b2511e18295a77ef
msgid "Ability to remotely manage the Qubes OS."
msgstr ""

#: ../../../developer/services/admin-api.rst:16
#: 4743c1fd795f4d00a831a787664274e5
msgid ""
