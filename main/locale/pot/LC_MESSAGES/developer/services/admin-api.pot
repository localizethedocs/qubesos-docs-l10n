#: ../../../developer/services/admin-api.rst:8 ce837de9d48c4eab9c8ff5c5b332141e
msgid "Goals"
msgstr ""

#: ../../../developer/services/admin-api.rst:10
#: 4d0af1e169814c3088915b7c7ef51273
msgid ""
"The goal of the Admin API system is to provide a way for the user to manage "
"qubes without direct access to dom0."
msgstr ""

#: ../../../developer/services/admin-api.rst:13
#: cffccabd607d4db2990de22c89d5ff4e
msgid "Benefits include:"
msgstr ""

#: ../../../developer/services/admin-api.rst:15
#: e54ab71c8b754b208a397580c3cef66f
msgid "The ability to remotely manage the Qubes OS."
msgstr ""

#: ../../../developer/services/admin-api.rst:16
#: d9ee048a791c4e92beaad1bdf2c1a0e1
msgid ""
"The possibility of creating multi-user system, where different users are "
"able to use different sets of qubes, possibly overlapping. This would also "
"require having more than one :term:`interface qube`"
msgstr ""

#: ../../../developer/services/admin-api.rst:20
#: 24df84e85235489e81cd1eb4b9fd52ae
msgid "The API would be used by:"
msgstr ""

#: ../../../developer/services/admin-api.rst:22
#: 2851161e694740e1a1683f89aa98bf0c
msgid "Qubes OS Manager (or any tools that would replace it)"
msgstr ""

#: ../../../developer/services/admin-api.rst:23
#: 63ce3732967e474b9bb40fa81d020604
msgid "CLI tools, when run from another qube (and possibly also from dom0)"
msgstr ""

#: ../../../developer/services/admin-api.rst:24
