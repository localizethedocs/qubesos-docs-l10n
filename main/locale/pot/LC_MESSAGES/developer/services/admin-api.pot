#: ../../../developer/services/admin-api.rst:15
#: 1df4021f62b64c0ca08c0cc55d848982
msgid "Ability to remotely manage the Qubes OS."
msgstr ""

#: ../../../developer/services/admin-api.rst:16
#: 882e89509853401e843114357fe68566
msgid ""
