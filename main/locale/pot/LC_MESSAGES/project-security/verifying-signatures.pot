msgid ":doc:`Qubes security pack </project-security/security-pack>`"
msgstr ""

#: ../../../project-security/verifying-signatures.rst:91
#: e0cf0eb99a3e40f4aa6297bacefa2fa7
msgid ""
"`Qubes keyserver <https://keys.qubes-os.org/keys/qubes-master-signing-key."
"asc>`__"
msgstr ""

#: ../../../project-security/verifying-signatures.rst:93
#: 90f79f8b04dc4145a85076f891647302
msgid ""
"`Email to qubes-devel <https://groups.google.com/d/msg/qubes-devel/"
"RqR9WPxICwg/kaQwknZPDHkJ>`__"
msgstr ""

#: ../../../project-security/verifying-signatures.rst:95
#: 2bf28b0c32a54ea9a3ce697984e1283f
msgid ""
"`Email to qubes-users <https://groups.google.com/d/msg/qubes-users/"
