msgid ""
"`Email to qubes-devel <https://groups.google.com/d/msg/qubes-devel/"
"RqR9WPxICwg/kaQwknZPDHkJ>`__"
msgstr ""

#: ../../../project-security/verifying-signatures.rst:95
#: 6bd557f033d243cabe1b98919808bd98
msgid ""
"`Email to qubes-users <https://groups.google.com/d/msg/qubes-users/"
