#: ../../../user/how-to-guides/backup-emergency-restore-v4.rst:118
#: 1b25ca7fa6c64b2aa793120ea0aab06b
msgid "Read ``backup-header``."
msgstr ""

#: ../../../user/how-to-guides/backup-emergency-restore-v4.rst:132
#: 6f42d6b69c6c404ab22697a7900464c9
msgid ""
"Set ``backup_id`` to the value in the last line of ``backup-header``. (Note "
"that there is a hyphen in ``backup-id`` in the file, whereas there is an "
"underscore in ``backup_id`` in the variable you’re setting.)"
msgstr ""

#: ../../../user/how-to-guides/backup-emergency-restore-v4.rst:140
#: adbf8b8e7d8a48489a62068a8d5d8cdd
