#: ../../../introduction/intro.rst:49 6c0638fdcdd3411bb18e79d2617f8339
msgid "Device isolation"
msgstr "裝置隔離"

#: ../../../introduction/intro.rst:50 24a56a928f1a47e6b75ebffd2b05e8b2
